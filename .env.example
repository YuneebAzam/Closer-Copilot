# Copy this file to .env and fill in your values. Never commit .env.

# --- Required ---
DEEPGRAM_API_KEY=          # console.deepgram.com
OPENAI_API_KEY=            # platform.openai.com
SUPABASE_URL=              # https://<project>.supabase.co
SUPABASE_KEY=              # Supabase publishable / anon key

# --- Models (defaults shown) ---
LIVE_MODEL=gpt-4.1-mini        # live whisper during the call
PREP_MODEL=gpt-4.1             # pre-call battle plan
ANALYSIS_MODEL=gpt-4.1-mini    # post-call Client Brain extraction
# OPENAI_BASE_URL=https://api.openai.com/v1   # change for an OpenAI-compatible provider

# --- Server ---
# PORT=7801
# HOST=127.0.0.1           # use 0.0.0.0 when deployed (Render/Railway)

# --- Admin panel (optional) ---
# SUPABASE_SERVICE_KEY=    # Supabase service_role key. Server-side only, keep secret.

# --- Meeting notetaker (optional) ---
# RECALL_API_KEY=
# RECALL_REGION=us-west-2
# BOT_WORKER_URL=
# BOT_SHARED_SECRET=
# BOT_NAME=Closer Copilot Notetaker
# BOT_PORT=7802
# BOT_HOST=0.0.0.0
# BOT_HEADLESS=true
# BOT_MAX_MINUTES=120
# RECORDING_PUBLIC_BASE=   # public URL for stored recordings (or R2_PUBLIC_BASE)

# --- Share links (optional) ---
# APP_ORIGIN=              # public app URL used in share links (or PUBLIC_BASE_URL)
# SHARE_TTL_DAYS=0         # 0 = links never expire

# --- scripts/replay.js only ---
# REPLAY_EMAIL=
# REPLAY_PASSWORD=
